# Python
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env

# Data Mentah & Data Olahan (Air-Gapped / Lokal)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/dlq/*
!data/dlq/.gitkeep

# ChromaDB Data Storage (Local Container Volume)
chroma_data/
.chroma/

# Model Weights Cache
models/
.cache/
huggingface/

# IDE & OS
.vscode/
.idea/
.DS_Store
# Logs & Execution Traces
logs/*
!logs/.gitkeep
*.log

